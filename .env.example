# Copy to .env (never committed). Everything here has a working default for a laptop with no tunnel.

# The web server
PORT=8787
# Private links (setup page, stage) carry this. Set it so links survive restarts; unset = a new one each start.
ADMIN_KEY=

# The test mint (cdk-mintd, fake Lightning wallet, SQLite under data/mint)
MINT_PORT=3340
# The mint's public URL: it goes into every token and payment request, so phones must be able to reach it.
MINT_URL=http://127.0.0.1:3340

# Cloudflare named tunnel (optional). Unset TUNNEL = no tunnel; the site is http://localhost:8787 only.
TUNNEL=
SITE_HOST=nutpub.example.com
MINT_HOST=nutpub-mint.example.com
